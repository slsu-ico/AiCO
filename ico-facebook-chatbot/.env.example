# Configure the ICO Page only. Replace placeholders locally or in host secret settings.
ICO_PAGE_ID=replace-with-the-numeric-ico-page-id
PAGE_ACCESS_TOKEN=replace-with-the-ico-page-access-token
MESSENGER_APP_SECRET=replace-with-your-meta-app-secret
MESSENGER_VERIFY_TOKEN=replace-with-a-long-random-verification-secret
# Use a supported version shown in the Meta app dashboard, e.g. v24.0.
META_GRAPH_VERSION=replace-with-your-meta-api-version
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
