{
  "name": "slsu-ico-facebook-chatbot",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone ICO-only Facebook Messenger service and official-form guide.",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/runtime.js",
